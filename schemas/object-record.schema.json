{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Biswajit1999/cosmic-lookback/schemas/object-record.schema.json",
  "title": "COSMIC LOOKBACK canonical object record",
  "type": "object",
  "required": ["canonicalId", "sourceRecords", "position", "provenance"],
  "properties": {
    "canonicalId": { "type": "string" },
    "sourceRecords": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["survey", "release", "objectId"],
        "properties": {
          "survey": { "type": "string" },
          "release": { "type": "string" },
          "objectId": { "type": "string" },
          "accessUrl": { "type": "string", "format": "uri" }
        },
        "additionalProperties": true
      }
    },
    "position": {
      "type": "object",
      "required": ["frame", "raDeg", "decDeg"],
      "properties": {
        "frame": { "const": "ICRS" },
        "raDeg": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
        "decDeg": { "type": "number", "minimum": -90, "maximum": 90 },
        "uncertaintyArcsec": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "redshift": {
      "type": ["object", "null"],
      "properties": {
        "kind": { "enum": ["spectroscopic", "photometric"] },
        "value": { "type": "number", "minimum": 0 },
        "lower68": { "type": ["number", "null"] },
        "upper68": { "type": ["number", "null"] },
        "posteriorRef": { "type": ["string", "null"] },
        "quality": { "type": ["string", "number", "null"] }
      },
      "required": ["kind", "value"]
    },
    "observations": { "type": "array", "items": { "type": "object" } },
    "measurements": { "type": "array", "items": { "$ref": "#/$defs/knowledgeValue" } },
    "inferences": { "type": "array", "items": { "$ref": "#/$defs/knowledgeValue" } },
    "transfers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["operatorVersion", "target", "seed", "status"],
        "properties": {
          "operatorVersion": { "type": "string" },
          "target": { "type": "object" },
          "seed": { "type": "integer" },
          "status": { "const": "simulated" },
          "outputChecksum": { "type": ["string", "null"] }
        }
      }
    },
    "domain": {
      "type": "object",
      "properties": {
        "oodScore": { "type": ["number", "null"] },
        "abstained": { "type": "boolean" },
        "reason": { "type": ["string", "null"] }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["createdByCommit"],
      "properties": {
        "createdByCommit": { "type": "string" },
        "inputChecksums": { "type": "array", "items": { "type": "string" } },
        "configurationHash": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "knowledgeValue": {
      "type": "object",
      "required": ["name", "status", "value", "methodVersion"],
      "properties": {
        "name": { "type": "string" },
        "status": { "enum": ["measured", "inferred", "simulated", "unavailable", "uncertain-ood"] },
        "value": {},
        "unit": { "type": ["string", "null"] },
        "uncertainty": {},
        "methodVersion": { "type": "string" },
        "validityGate": { "type": ["string", "null"] }
      }
    }
  },
  "additionalProperties": true
}
